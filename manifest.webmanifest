{
  "name": "FamilyHub",
  "short_name": "FamilyHub",
  "description": "Совместные дела и важные заметки всей семьи. Работает без интернета.",
  "lang": "ru",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F4F2",
  "theme_color": "#F4F4F2",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Добавить дело",
      "short_name": "Дело",
      "description": "Быстро добавить дело для семьи",
      "url": "./index.html?go=new-task",
      "icons": [
        {
          "src": "sc-task.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Добавить заметку",
      "short_name": "Заметка",
      "description": "Быстро добавить заметку",
      "url": "./index.html?go=new-note",
      "icons": [
        {
          "src": "sc-note.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Перейти в чат",
      "short_name": "Чат",
      "description": "Открыть семейный чат",
      "url": "./index.html?go=chat",
      "icons": [
        {
          "src": "sc-chat.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "stitle",
      "text": "stext",
      "url": "surl",
      "files": [
        {
          "name": "sfiles",
          "accept": [
            "image/*"
          ]
        },
        {
          "name": "sdocs",
          "accept": [
            "application/pdf",
            "text/plain"
          ]
        }
      ]
    }
  }
}